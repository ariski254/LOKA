<Window x:Class="Loka.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Loka.Installer.ViewModels"
        mc:Ignorable="d"
        Title="LOKA Setup"
        Icon="Resources/loka.ico"
        Width="700" Height="580"
        MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI, Inter, Arial">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="Resources/logo.png" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InstallerTypeTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="3" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBlock Text="{Binding InstallerTypeBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Windows Local Development Environment Made Simple" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with View States -->
        <Grid Grid.Row="1" Margin="24,18">

            <!-- 1. WELCOME VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveView}" Value="Welcome">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding InstallerTypeTitle, StringFormat='Welcome to {0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding InstallerTypeDescription}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

                        <!-- Installation Mode Selection Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Installation Mode" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10" />

                                <RadioButton GroupName="InstallMode" IsChecked="{Binding IsRecommendedMode}" Margin="0,0,0,8">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Install Recommended (Standard Development Stack)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Standard package: Apache, Nginx, PHP 8.4, MariaDB 11.8, Node.js, Git, Composer &amp; phpMyAdmin. (Additional engines available on demand)." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="InstallMode" IsChecked="{Binding IsCustomMode}" Margin="0,0,0,8">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Custom Installation" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Select individual web servers, PHP versions, database engines, and development tools." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="InstallMode" IsChecked="{Binding IsRepairMode}" Margin="0,0,0,8">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Repair Installation" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Validates all binaries and heals missing configuration or shortcuts without affecting projects." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton GroupName="InstallMode" IsChecked="{Binding IsUpdateMode}">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Update LOKA" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="Updates application core and runtime packages while preserving all user projects and databases." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>

                        <!-- Custom Components Checklist (Shown only when Custom Mode is selected) -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCustomMode}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Select Components to Install" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Select All" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllComponentsCommand}" Height="24" Padding="8,0" FontSize="11" Margin="0,0,6,0" />
                                        <Button Content="Deselect All" Style="{StaticResource SecondaryButton}" Command="{Binding DeselectAllComponentsCommand}" Height="24" Padding="8,0" FontSize="11" />
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Column 1: Web Servers & PHP -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Web Servers" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4" />
                                        <CheckBox Content="Nginx (1.28)" IsChecked="{Binding InstallNginx}" FontSize="11.5" Margin="4,0,0,4" />
                                        <CheckBox Content="Apache (2.4)" IsChecked="{Binding InstallApache}" FontSize="11.5" Margin="4,0,0,8" />

                                        <TextBlock Text="PHP Runtimes" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,4" />
                                        <CheckBox Content="PHP 8.3 (LTS CLI &amp; Web)" IsChecked="{Binding InstallPhp83}" FontSize="11.5" Margin="4,0,0,4" />
                                        <CheckBox Content="PHP 8.4 (Default CLI &amp; Web)" IsChecked="{Binding InstallPhp84}" FontSize="11.5" Margin="4,0,0,4" />
                                        <CheckBox Content="PHP 8.5 (FastCGI &amp; CLI)" IsChecked="{Binding InstallPhp85}" FontSize="11.5" Margin="4,0,0,4" />
                                    </StackPanel>

                                    <!-- Column 2: Databases & Tools -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock Text="Databases" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4" />
                                        <CheckBox Content="MariaDB (11.8 LTS)" IsChecked="{Binding InstallMariaDb}" FontSize="11.5" Margin="4,0,0,4" />
                                        <CheckBox Content="MySQL (8.4 LTS)" IsChecked="{Binding InstallMySql}" FontSize="11.5" Margin="4,0,0,4" />
                                        <CheckBox Content="PostgreSQL (17)" IsChecked="{Binding InstallPostgreSql}" FontSize="11.5" Margin="4,0,0,8" />

                                        <TextBlock Text="Developer Tools" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,4" />
                                        <CheckBox Content="Node.js (22 LTS) &amp; npm" IsChecked="{Binding InstallNodeJs}" FontSize="11.5" Margin="4,0,0,4" />
                                        <CheckBox Content="Git (MinGit 64-bit)" IsChecked="{Binding InstallGit}" FontSize="11.5" Margin="4,0,0,4" />
                                        <CheckBox Content="Composer (2.10)" IsChecked="{Binding InstallComposer}" FontSize="11.5" Margin="4,0,0,4" />
                                        <CheckBox Content="phpMyAdmin (5.2)" IsChecked="{Binding InstallPhpMyAdmin}" FontSize="11.5" Margin="4,0,0,4" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Path Selection Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Application Directory" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="LOKA core executables, GUI, and system integration tools." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" />
                                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseFolderCommand}" Margin="8,0,0,0" Height="32" Padding="12,0" />
                                </Grid>
                                <TextBlock Text="{Binding DiskSpaceSummary}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Environment Location Info Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Environment &amp; Development Data Directory" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock Text="Your projects, databases, SSL certificates, logs, and stack binaries are stored securely in:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                <TextBlock Text="{Binding EnvironmentPath}" FontFamily="Consolas, Cascadia Code" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Options Card -->
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Additional Options" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <CheckBox Content="Create shortcut in Start Menu" IsChecked="{Binding CreateStartMenuShortcut}" FontSize="12" Margin="0,0,0,8" />
                                <CheckBox Content="Create shortcut on Desktop" IsChecked="{Binding CreateDesktopShortcut}" FontSize="12" Margin="0,0,0,8" />
                                <CheckBox Content="Launch LOKA after installation finishes" IsChecked="{Binding LaunchAfterInstall}" FontSize="12" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- 2. INSTALLING VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveView}" Value="Installing">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Installing LOKA..." FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Progress Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="6" />
                    </Grid>

                    <!-- Detailed Steps Card -->
                    <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. FINISHED VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveView}" Value="Finished">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <Border Width="64" Height="64" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LOKA Installation Completed!" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Your local web development environment is ready to use." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20,16" Width="440" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Installation Summary:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding InstallPath, StringFormat='Application: {0}'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding EnvironmentPath, StringFormat='Environment: {0}'}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <Separator Background="{StaticResource BorderBrush}" Margin="0,4,0,8" />
                            <CheckBox Content="Launch LOKA now" IsChecked="{Binding LaunchAfterInstall}" FontSize="12" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 4. UNINSTALL VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveView}" Value="Uninstall">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel VerticalAlignment="Center" Margin="20">
                    <Border Width="56" Height="56" Background="{StaticResource DangerBgBrush}" BorderBrush="{StaticResource DangerBorderBrush}" BorderThickness="1" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock Text="✕" FontSize="30" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Uninstall LOKA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Are you sure you want to remove LOKA from this computer?" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18,14" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Complete Cleanup Options:" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="The uninstaller will remove all application binaries, services, shortcuts, and registry entries." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                            <CheckBox Content="Remove entire environment folder and contents in C:\Loka\ (stack binaries, databases, and config)" 
                                      IsChecked="{Binding RemoveEnvironmentData}" 
                                      FontSize="11.5" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 5. UNINSTALLING VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveView}" Value="Uninstalling">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
                    <TextBlock Text="Uninstalling LOKA..." FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />
                    <ProgressBar Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="6" Foreground="{StaticResource PrimaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 6. UNINSTALL FINISHED VIEW -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ActiveView}" Value="UninstallFinished">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                    <Border Width="64" Height="64" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="32" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="LOKA Successfully Uninstalled" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="The LOKA development application has been removed from your computer." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,24" />
                </StackPanel>
            </Grid>

        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <!-- Welcome Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="Welcome">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Content="{Binding InstallActionText}" Style="{StaticResource PrimaryButton}" Command="{Binding StartInstallationCommand}" />
                </StackPanel>

                <!-- Installing Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="Installing">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Installing..." Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                </StackPanel>

                <!-- Finished Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="Finished">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Finish" Style="{StaticResource PrimaryButton}" Command="{Binding FinishCommand}" />
                </StackPanel>

                <!-- Uninstall Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="Uninstall">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,10,0" />
                    <Button Content="Uninstall LOKA" Style="{StaticResource DangerButton}" Command="{Binding StartUninstallationCommand}" />
                </StackPanel>

                <!-- Uninstall Finished Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveView}" Value="UninstallFinished">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="Close" Style="{StaticResource PrimaryButton}" Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
