<UserControl x:Class="Loka.App.Views.PhpMyAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Loka.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PhpMyAdminViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="phpMyAdmin" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                    <TextBlock Text="Database web administration" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <Button Grid.Column="1" Content="↻ Refresh" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"
                        Height="26" Padding="10,0" FontSize="11.5" VerticalAlignment="Center" />
            </Grid>

            <!-- Current Active Server Banner -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="CURRENT ACTIVE SERVER" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" FontSize="11" Margin="0,0,7,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="○" />
                                        <Setter Property="Foreground" Value="{StaticResource NeutralBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentServerRunning}" Value="True">
                                                <Setter Property="Text" Value="●" />
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CurrentServerName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentServerPort, StringFormat=' (Port: {0})'}" FontSize="12" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Switch Server Controls (Visible when both are running) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanSwitchServer}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Switch Server:" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button Content="MySQL" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SetCurrentServerCommand}" CommandParameter="MySQL"
                                Height="24" Padding="8,0" FontSize="11" Margin="0,0,4,0" />
                        <Button Content="MariaDB" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SetCurrentServerCommand}" CommandParameter="MariaDB"
                                Height="24" Padding="8,0" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Server Cards Section Title -->
            <TextBlock Text="Database Servers" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" />

            <!-- MySQL Status Card -->
            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,10">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="MySQL" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="9" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="○" />
                                    <Setter Property="Foreground" Value="{StaticResource NeutralBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMySqlRunning}" Value="True">
                                            <Setter Property="Text" Value="●" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding MySqlStatus}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding MySqlPort, StringFormat=':{0}'}"
                               FontFamily="Cascadia Code, Consolas" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding MySqlVersion, StringFormat='v{0}'}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Set Active"
                                Command="{Binding SetCurrentServerCommand}" CommandParameter="MySQL"
                                Height="24" Padding="8,0" FontSize="11" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMySqlRunning}" Value="True" />
                                                <Condition Binding="{Binding CanSwitchServer}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ToggleMySqlCommand}"
                                Height="24" Padding="12,0" FontSize="11.5" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Content" Value="Start" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMySqlRunning}" Value="True">
                                            <Setter Property="Content" Value="Stop" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- MariaDB Status Card -->
            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,16">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="MariaDB" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="9" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="○" />
                                    <Setter Property="Foreground" Value="{StaticResource NeutralBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMariaDbRunning}" Value="True">
                                            <Setter Property="Text" Value="●" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding MariaDbStatus}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding MariaDbPort, StringFormat=':{0}'}"
                               FontFamily="Cascadia Code, Consolas" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                    <TextBlock Grid.Column="3" Text="{Binding MariaDbVersion, StringFormat='v{0}'}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Set Active"
                                Command="{Binding SetCurrentServerCommand}" CommandParameter="MariaDB"
                                Height="24" Padding="8,0" FontSize="11" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMariaDbRunning}" Value="True" />
                                                <Condition Binding="{Binding CanSwitchServer}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Command="{Binding ToggleMariaDbCommand}"
                                Height="24" Padding="12,0" FontSize="11.5" VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Setter Property="Content" Value="Start" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMariaDbRunning}" Value="True">
                                            <Setter Property="Content" Value="Stop" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Primary Action: Open phpMyAdmin -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Open phpMyAdmin ↗" Style="{StaticResource PrimaryButton}"
                        Command="{Binding OpenInBrowserCommand}"
                        Height="28" Padding="16,0" FontSize="12" Margin="0,0,8,0" />
            </StackPanel>

            <!-- Connection Credentials -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="HOST" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding DatabaseHost}" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="ACTIVE PORT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding CurrentServerPort, StringFormat=':{0}'}" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="USERNAME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding DatabaseRootUser}" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="PASSWORD" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding DatabaseRootPassword}" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inline Status message -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
