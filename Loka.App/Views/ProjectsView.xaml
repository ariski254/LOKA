<UserControl x:Class="Loka.App.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Loka.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ProjectsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16">

            <!-- Page Header (Ui.md Section 20 & 22) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Projects" Style="{StaticResource HeadingLarge}" />
                    <TextBlock Text="Manage local web projects and virtual hosts"
                               Style="{StaticResource SubHeading}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="+ New" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding ToggleAddProjectCommand}" Height="26" Padding="12,0" FontSize="11.5" Margin="0,0,6,0" />
                    <Button Content="Sync Domains" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding SyncAllDomainsCommand}" Height="26" Padding="10,0" FontSize="11.5" Margin="0,0,6,0"
                            ToolTip="Synchronize virtual hosts and register .test domains" />
                    <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding LoadProjectsCommand}" Height="26" Padding="8,0" FontSize="11.5" />
                </StackPanel>
            </Grid>

            <!-- Loading Indicator -->
            <ProgressBar Height="2" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" 
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,6" 
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Add Project Form (Compact Single Input) -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAddProjectVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="New Project" Style="{StaticResource HeadingMedium}" Margin="0,0,0,2" />
                    <TextBlock Text="Domain and directory are generated automatically from project name"
                               Style="{StaticResource CaptionText}" Margin="0,0,0,8" />

                    <!-- Single Input: Project Name -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Project Name:" FontWeight="Medium" FontSize="12" Width="95" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="28" VerticalContentAlignment="Center" />
                    </Grid>

                    <!-- Auto Preview Details -->
                    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Domain:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NewProjectDomain, TargetNullValue='(auto .test)'}" 
                                       Style="{StaticResource CodeText}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Folder:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NewProjectPath, TargetNullValue='(auto in projects)'}" 
                                       Style="{StaticResource CodeText}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Custom Folder Toggle (Optional) -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock>
                            <Hyperlink Command="{Binding ToggleCustomPathCommand}" TextDecorations="None">
                                <Run Text="Use custom folder location (optional)" FontSize="11" />
                            </Hyperlink>
                        </TextBlock>

                        <Grid Margin="0,4,0,0" Visibility="{Binding IsCustomPathVisible, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewProjectPath, UpdateSourceTrigger=PropertyChanged}" Height="28" 
                                     VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding BrowseProjectPathCommand}" Margin="4,0,0,0" Height="28" Padding="10,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Options Row -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Framework" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding FrameworkOptions}" SelectedItem="{Binding NewProjectFramework}" Height="28" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="2,0,2,0">
                            <TextBlock Text="PHP Version" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding PhpVersionOptions}" SelectedItem="{Binding NewProjectPhpVersion}" Height="28" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Text="Web Server" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding WebServerOptions}" SelectedItem="{Binding NewProjectWebServer}" Height="28" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" 
                                IsEnabled="{Binding IsNotLoading}"
                                Command="{Binding ToggleAddProjectCommand}" Height="26" Padding="10,0" Margin="0,0,6,0" />
                        <Button Content="{Binding CreateButtonText}" Style="{StaticResource PrimaryButton}" 
                                IsEnabled="{Binding IsNotLoading}"
                                Command="{Binding CreateProjectCommand}" Height="26" Padding="12,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Compact Projects Table (Ui.md Section 22: Compact rows) -->
            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="4" Padding="0" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Table Header -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="12,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PROJECT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="DOMAIN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="ENVIRONMENT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="ACTIONS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Empty State -->
                    <Border Padding="24" Visibility="{Binding Projects.Count, Converter={StaticResource BoolToVis}, ConverterParameter='inverse'}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="No projects found." Style="{StaticResource SubHeading}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <Button Content="+ New Project" Style="{StaticResource PrimaryButton}" 
                                    Command="{Binding ToggleAddProjectCommand}" Height="26" Padding="12,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Items List -->
                    <ItemsControl ItemsSource="{Binding Projects}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,5" MinHeight="36">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Project Name & Status Dot -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" FontSize="9" Margin="0,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="○" />
                                                        <Setter Property="Foreground" Value="{StaticResource NeutralBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Text" Value="●" />
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" 
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        </StackPanel>

                                        <!-- Domain Link (Clean URL per Ui.md) -->
                                        <TextBlock Grid.Column="1" Text="{Binding LocalUrl}" Style="{StaticResource CodeText}" 
                                                   Foreground="{StaticResource AccentBrush}" Cursor="Hand" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalUrl}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding Gesture="LeftClick" 
                                                              Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding}" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>

                                        <!-- Tags: Framework + PHP Version -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding FrameworkName}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,1">
                                                <TextBlock Text="{Binding PhpVersion, StringFormat='PHP {0}', TargetNullValue='PHP Default'}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Primary Actions: [ Open ] [ Folder ] [ Terminal ] [ Remove ] [ Delete ] -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button Content="Open ↗" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Height="24" Padding="6,0" FontSize="11" Margin="0,0,3,0"
                                                    ToolTip="{Binding LocalUrl, StringFormat='Open {0} in browser'}" />

                                            <Button Content="Folder" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Height="24" Padding="6,0" FontSize="11" Margin="0,0,3,0"
                                                    ToolTip="Open project folder in Windows Explorer" />

                                            <Button Content="Terminal" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.OpenTerminalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Height="24" Padding="6,0" FontSize="11" Margin="0,0,3,0"
                                                    ToolTip="Open terminal in project" />

                                            <Button Content="Remove" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding DataContext.RemoveProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Height="24" Padding="6,0" FontSize="11" Margin="0,0,3,0"
                                                    ToolTip="Remove project from Loka (keeps files safe on disk)" />

                                            <Button Content="Delete" Style="{StaticResource DangerButton}"
                                                    Command="{Binding DataContext.DeleteProjectAndFilesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Height="24" Padding="6,0" FontSize="11"
                                                    ToolTip="Permanently delete project and all files from disk" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Inline Status Message -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
