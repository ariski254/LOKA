<UserControl x:Class="Loka.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Loka.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DiagnosticsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16">

            <!-- Header (Ui.md Section 20 & 25) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                    <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Copy Report" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding CopyReportCommand}" Height="26" Padding="10,0" FontSize="11.5" Margin="0,0,6,0" />
                    <Button Content="Export Report" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding ExportReportCommand}" Height="26" Padding="10,0" FontSize="11.5" Margin="0,0,6,0" />
                    <Button Content="↻ Scan / Refresh" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding RefreshCommand}" Height="26" Padding="12,0" FontSize="11.5" />
                </StackPanel>
            </Grid>

            <!-- Compact Diagnostics List (Ui.md Section 25: Simple, clean rows with subtle ✓ Ready) -->
            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="4" Padding="0" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Table Header -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COMPONENT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="DETAILS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6" MinHeight="34">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Component Name -->
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="Medium" FontSize="12.5" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                        <!-- Subtle Status Indicator (Ui.md Section 25: ✓ Ready) -->
                                        <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="✕ Missing" />
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPassed}" Value="True">
                                                            <Setter Property="Text" Value="✓ Ready" />
                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Details & Location -->
                                        <TextBlock Grid.Column="2" Text="{Binding Details}" FontSize="11.5" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Status / Feedback Message -->
            <TextBlock Text="{Binding StatusFeedback}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
