<UserControl x:Class="Loka.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Loka.App.ViewModels"
             xmlns:conv="clr-namespace:Loka.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:TerminalViewModel}">

    <UserControl.Resources>
        <conv:UniversalBooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: Minimalist Top Bar with Working Directory & Clean Actions -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="Terminal" Style="{StaticResource HeadingLarge}" />
                <TextBlock Text="Integrated PowerShell development shell in active Loka environment" 
                           Style="{StaticResource SubHeading}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Working Directory Selector (Compact) -->
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="DIR:" FontWeight="SemiBold" FontSize="10.5" 
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}"
                                  DisplayMemberPath="Name" Width="120" Height="22" FontSize="11" Margin="0,0,6,0"
                                  ToolTip="Switch active project working directory" />
                        <TextBlock Text="{Binding WorkingDirectory}" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                   FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="{Binding WorkingDirectory}" />
                        <Button Content="Browse..." Style="{StaticResource SecondaryButton}" 
                                Command="{Binding BrowseWorkingDirectoryCommand}" Height="22" Padding="6,0" FontSize="10.5" />
                    </StackPanel>
                </Border>

                <Button Content="Clear" Style="{StaticResource SecondaryButton}" Command="{Binding ClearOutputCommand}" Height="26" Padding="10,0" FontSize="11.5" />
            </StackPanel>
        </Grid>

        <!-- Native-Style Interactive PowerShell Terminal Viewport -->
        <Border Grid.Row="1" Background="{StaticResource TerminalBackgroundBrush}" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Shell Titlebar -->
                <Border Grid.Row="0" Background="{StaticResource TerminalHeaderBackgroundBrush}" BorderBrush="{StaticResource TerminalBorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="●" Foreground="{StaticResource TerminalPromptBrush}" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="PowerShell (Loka Internal PATH)" Style="{StaticResource CodeText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="[Executing...]" FontSize="11" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}" />
                            <Button Content="Stop (Ctrl+C)" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding StopExecutionCommand}" Height="20" Padding="6,0" FontSize="10"
                                    FontWeight="SemiBold"
                                    Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable Continuous Terminal Buffer with Inline Active Prompt -->
                <ScrollViewer x:Name="TerminalScrollViewer" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              Padding="12,10"
                              PreviewMouseDown="OnTerminalAreaMouseDown">
                    <StackPanel x:Name="TerminalFlowPanel" VerticalAlignment="Top">
                        <!-- Historical Output Buffer (Selectable, Read-Only) -->
                        <TextBox x:Name="TerminalOutputBox"
                                 Text="{Binding TerminalText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TerminalTextBrush}"
                                 CaretBrush="Transparent"
                                 SelectionBrush="{StaticResource TerminalSelectionBrush}"
                                 SelectionOpacity="0.7"
                                 FontFamily="Cascadia Mono, Consolas, Courier New"
                                 FontSize="12"
                                 Padding="0"
                                 Margin="0,0,0,2"
                                 Cursor="IBeam"
                                 IsReadOnlyCaretVisible="False"
                                 VerticalScrollBarVisibility="Disabled"
                                 HorizontalScrollBarVisibility="Disabled"
                                 TextChanged="TerminalOutputBox_TextChanged"
                                 PreviewKeyDown="TerminalOutputBox_PreviewKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="0" Padding="0" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                                    <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" />
                                    <Separator />
                                    <MenuItem Header="Clear" Command="{Binding ClearOutputCommand}" />
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>

                        <!-- Active In-Line Prompt Row (Interactive Text Input directly in the terminal flow) -->
                        <Grid x:Name="ActivePromptGrid" Margin="0,1,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding CurrentPrompt}"
                                       FontFamily="Cascadia Mono, Consolas, Courier New"
                                       FontSize="12"
                                       Foreground="{StaticResource TerminalPromptBrush}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0" />
                            <TextBox x:Name="CommandInputBox" Grid.Column="1"
                                     Text="{Binding CurrentCommand, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Cascadia Mono, Consolas, Courier New"
                                     FontSize="12"
                                     Foreground="{StaticResource TerminalTextBrush}"
                                     CaretBrush="{StaticResource TextPrimaryBrush}"
                                     SelectionBrush="{StaticResource TerminalSelectionBrush}"
                                     SelectionOpacity="0.7"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     Margin="0"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     PreviewKeyDown="CommandInputBox_PreviewKeyDown">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Margin="0" Padding="0" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                                <TextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Cut" Command="ApplicationCommands.Cut" />
                                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy" />
                                        <MenuItem Header="Paste" Command="ApplicationCommands.Paste" />
                                        <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll" />
                                        <Separator />
                                        <MenuItem Header="Clear" Command="{Binding ClearOutputCommand}" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
