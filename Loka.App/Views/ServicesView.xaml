<UserControl x:Class="Loka.App.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Loka.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:ServicesViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16">

            <!-- Compact Header (Ui.md Section 7, 8, 9, 20) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Services" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,3" />
                    <TextBlock Text="Local server and database services" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Global Action Controls (Ui.md Section 6, 9: One dynamic Start All/Stop All button) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding GlobalActionText}"
                            Command="{Binding ToggleAllServicesCommand}"
                            Height="26" Padding="12,0" FontSize="11.5" Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRunningServices}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource SecondaryButtonControlTemplate}" />
                                        <Setter Property="Background" Value="{StaticResource ButtonSecondaryBackgroundBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource ButtonSecondaryForegroundBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource ButtonSecondaryBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="↻ Refresh" Style="{StaticResource SecondaryButton}" 
                            Command="{Binding RefreshServicesCommand}" Height="26" Padding="8,0" FontSize="11.5" />
                </StackPanel>
            </Grid>

            <!-- Compact Services Table (Ui.md Section 7 & 30: Rows 36px, fits all 5 services without scroll) -->
            <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" 
                    BorderThickness="1" CornerRadius="4" Padding="0" Margin="0,0,0,14">
                <StackPanel>
                    <!-- Table Column Header -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="14,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SERVICE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="1" Text="STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="2" Text="PORT" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Grid.Column="3" Text="" />
                            <TextBlock Grid.Column="4" Text="ACTION" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Services}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6" MinHeight="36">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Service Name & Version -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Status Indicator (Ui.md Section 16: Subtle dot) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock VerticalAlignment="Center" FontSize="9" Margin="0,0,6,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="○" />
                                                        <Setter Property="Foreground" Value="{StaticResource NeutralBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Text" Value="●" />
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Starting">
                                                                <Setter Property="Text" Value="◐" />
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Stopping">
                                                                <Setter Property="Text" Value="◑" />
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Error">
                                                                <Setter Property="Text" Value="●" />
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding State}" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>

                                        <!-- Port -->
                                        <TextBlock Grid.Column="2" Text="{Binding Port, StringFormat=':{0}'}"
                                                   FontFamily="Cascadia Code, Consolas" FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />

                                        <!-- Spacer / Details Column -->
                                        <TextBlock Grid.Column="3" Text="" />

                                        <!-- Action: ONE dynamic Start/Stop button + secondary menu (Ui.md Section 6, 8, 17) -->
                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button Command="{Binding DataContext.ToggleServiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="{Binding ActionText}"
                                                    IsEnabled="{Binding CanToggle}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="24" Padding="12,0" FontSize="11.5" />

                                            <!-- Secondary Actions Dropdown Menu (Ui.md Section 8) -->
                                            <Button Content="•••" Click="MoreOptions_Click"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource SecondaryButton}" Height="24" Width="26" Padding="0" Margin="4,0,0,0"
                                                    ToolTip="More actions (Restart, Config, Logs)">
                                                <Button.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Restart Service"
                                                                  Command="{Binding PlacementTarget.Tag.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  IsEnabled="{Binding PlacementTarget.DataContext.CanRestart, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Separator />
                                                        <MenuItem Header="Edit Configuration"
                                                                  Command="{Binding PlacementTarget.Tag.OpenConfigCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Open Config Folder"
                                                                  Command="{Binding PlacementTarget.Tag.OpenConfigFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Separator />
                                                        <MenuItem Header="View Log File"
                                                                  Command="{Binding PlacementTarget.Tag.OpenLogsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Open Log Folder"
                                                                  Command="{Binding PlacementTarget.Tag.OpenLogFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Separator />
                                                        <MenuItem Header="Open Service Folder"
                                                                  Command="{Binding PlacementTarget.Tag.OpenServiceFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Status Indicator Bar with TextWrapping -->
            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
