<Window x:Class="Loka.App.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Loka.App.ViewModels"
        mc:Ignorable="d"
        Title="Loka - Environment Setup"
        Icon="pack://application:,,,/Loka;component/Resources/loka.ico"
        Height="540" Width="740"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="{StaticResource BackgroundBrush}"
        d:DataContext="{d:DesignInstance Type=vm:SetupWizardViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="24" Height="24" Margin="0,0,10,0">
                        <Image Source="pack://application:,,,/Loka;component/Resources/logo_24.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Loka Environment Setup" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Configure your local development environment" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Step Counter / Indicator -->
                <Border Grid.Column="1" Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StepIndicatorText}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="28,16">

            <!-- Global Error Banner -->
            <Border Background="{StaticResource ErrorBgBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1" 
                    CornerRadius="4" Padding="12,8" VerticalAlignment="Top" Margin="0,0,0,12"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}" FontSize="12" FontWeight="SemiBold" />
            </Border>

            <!-- STEP 0: WELCOME SCREEN (Ui.md Section 3.A) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="580" Margin="0,10">
                    <Border Width="56" Height="56" Margin="0,0,0,14" HorizontalAlignment="Center">
                        <Image Source="pack://application:,,,/Loka;component/Resources/logo_primary.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="Your Local Development Environment" Style="{StaticResource HeadingLarge}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Fast, integrated local web development for Windows. Run Nginx, Apache, PHP 8.3+, and databases with zero configuration hassle." 
                               Style="{StaticResource SubHeading}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,18" />

                    <!-- Environment & System Detection Card -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Environment Directory:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding EnvironmentPath}" HorizontalAlignment="Right" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Storage Status:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding DriveSpaceInfo}" HorizontalAlignment="Right" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Grid>

                            <!-- Existing Environment Detection Badge -->
                            <Border Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,6,0,0"
                                    Visibility="{Binding IsExistingEnvironmentDetected, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✓ Existing Loka installation detected at C:\Loka. Your databases, runtimes, and projects will be safely preserved."
                                           FontSize="11" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Set Up Environment →" Style="{StaticResource PrimaryButton}" Command="{Binding NextStepCommand}" 
                                Height="36" Padding="20,0" FontSize="12.5" Margin="0,0,8,0" />
                        <Button Content="Use Existing Environment" Style="{StaticResource SecondaryButton}" Command="{Binding UseExistingEnvironmentCommand}" 
                                Height="36" Padding="16,0" FontSize="12"
                                Visibility="{Binding IsExistingEnvironmentDetected, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 1: ENVIRONMENT LOCATION (Ui.md Section 3.B Step 1) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="620" Margin="0,6">
                    <TextBlock Text="Environment Location" Style="{StaticResource HeadingLarge}" Margin="0,0,0,4" />
                    <TextBlock Text="Choose where Loka stores environment binaries, configurations, databases, and web projects:" 
                               Style="{StaticResource SubHeading}" Margin="0,0,0,18" />

                    <!-- Environment Root -->
                    <TextBlock Text="Environment Root Directory:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding EnvironmentPath, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12.5" VerticalContentAlignment="Center" Padding="8,0" />
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseEnvironmentCommand}" Margin="8,0,0,0" Height="34" Padding="12,0" />
                    </Grid>

                    <!-- Projects Directory -->
                    <TextBlock Text="Web Projects Directory:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ProjectsPath, UpdateSourceTrigger=PropertyChanged}" Height="34" FontSize="12.5" VerticalContentAlignment="Center" Padding="8,0" />
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseProjectsCommand}" Margin="8,0,0,0" Height="34" Padding="12,0" />
                    </Grid>

                    <!-- Safe Storage Callout -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" FontSize="11.5">
                            <Run Text="Safe Data Isolation: " FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="Loka keeps user data, databases, and projects separate from application files. Existing files and databases in this directory are safely preserved and never deleted." />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 2: WEB SERVER (Ui.md Section 3.B Step 2) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="620" Margin="0,6">
                    <TextBlock Text="Web Server Configuration" Style="{StaticResource HeadingLarge}" Margin="0,0,0,4" />
                    <TextBlock Text="Select your primary local web server daemon and port configuration:" 
                               Style="{StaticResource SubHeading}" Margin="0,0,0,16" />

                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Web Server Choice -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Preferred Web Server:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" SelectedItem="{Binding PreferredWebServer}" Height="32">
                                    <ComboBoxItem Content="Apache" IsSelected="True" />
                                    <ComboBoxItem Content="Nginx" />
                                </ComboBox>
                            </Grid>

                            <!-- HTTP Port -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HTTP Port:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="90" VerticalContentAlignment="Center" Padding="6,0" />
                                    <TextBlock Text="(Standard web port for http://localhost and *.test domains)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- HTTPS SSL Port -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="HTTPS SSL Port:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding HttpsPort, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="90" VerticalContentAlignment="Center" Padding="6,0" />
                                    <TextBlock Text="(Standard SSL port for https://*.test domains)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Port Conflict Alert -->
                            <Border Background="{StaticResource WarningBgBrush}" BorderBrush="{StaticResource WarningBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10"
                                    Visibility="{Binding HasPortConflict, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding PortConflictWarning}" FontSize="11" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                            </Border>

                            <CheckBox Content="Automatically start web server when Loka opens" IsChecked="{Binding AutoStartWebServer}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 3: PHP RUNTIME (Ui.md Section 3.B Step 3: Strictly >= PHP 8.3) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStep3, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="620" Margin="0,6">
                    <TextBlock Text="PHP Runtime Configuration" Style="{StaticResource HeadingLarge}" Margin="0,0,0,4" />
                    <TextBlock Text="Select your default active PHP version for FastCGI web processing and CLI tools:" 
                               Style="{StaticResource SubHeading}" Margin="0,0,0,14" />

                    <!-- PHP Version Cards -->
                    <ItemsControl ItemsSource="{Binding PhpVersions}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Radio button to select default -->
                                        <RadioButton Grid.Column="0" GroupName="PhpVersionSelection" VerticalAlignment="Center" Margin="0,0,12,0"
                                                     IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                     Command="{Binding DataContext.SelectPhpVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                     CommandParameter="{Binding Version}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding ReleaseInfo}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Background="{StaticResource SubtleBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" FontSize="11">
                            <Run Text="CLI &amp; FastCGI Synchronization: " FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="Loka automatically points the system PATH CLI php.exe and the FastCGI upstream daemon (127.0.0.1:9000) to your selected PHP version." />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 4: DATABASE (Ui.md Section 3.B Step 4) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStep4, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" MaxWidth="620" Margin="0,6">
                    <TextBlock Text="Database Configuration" Style="{StaticResource HeadingLarge}" Margin="0,0,0,4" />
                    <TextBlock Text="Select and configure your default SQL database engine:" 
                               Style="{StaticResource SubHeading}" Margin="0,0,0,16" />

                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Default Database:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding DatabaseOptions}" SelectedItem="{Binding PreferredDatabase}" Height="32" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Database Port:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding DatabasePort, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="90" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="6,0" />
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Root Password:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding DatabaseRootPassword, UpdateSourceTrigger=PropertyChanged}" Height="32" Width="180" HorizontalAlignment="Left" VerticalContentAlignment="Center" Padding="6,0" />
                                    <TextBlock Text="Leave empty for passwordless root (standard for local web development)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Automatically start database service on launch" IsChecked="{Binding AutoStartDatabase}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12,8">
                        <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" FontSize="11">
                            <Run Text="Data Preservation: " FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Run Text="Databases are located in C:\Loka\data. Existing database files are preserved automatically; no tables or data will be overwritten." />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- STEP 5: APPLY SETUP (Ui.md Section 3.B Step 5 & installasi.md) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStep5, Converter={StaticResource BoolToVis}}">
                <StackPanel MaxWidth="620" Margin="0,6">

                    <!-- Step Header: Always Visible on Step 5 -->
                    <TextBlock Text="Apply Setup" Style="{StaticResource HeadingLarge}" FontSize="18" Margin="0,0,0,4" />
                    <TextBlock Text="Review, execute, and verify your development environment configuration:" 
                               Style="{StaticResource SubHeading}" FontSize="12.5" Margin="0,0,0,14" />

                    <!-- STATE 1: READY TO APPLY -->
                    <StackPanel Visibility="{Binding IsStep5Ready, Converter={StaticResource BoolToVis}}">
                        <!-- Configuration Summary Card -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Environment Directory:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding EnvironmentPath}" HorizontalAlignment="Right" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Foreground="{StaticResource AccentBrush}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Projects Directory:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding ProjectsPath}" HorizontalAlignment="Right" FontFamily="Cascadia Code, Consolas" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Web Server:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding PreferredWebServer, StringFormat='{}{0} (Port: 80, SSL: 443)'}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Active PHP Runtime:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding SelectedPhpVersion, StringFormat='{}PHP {0}'}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="Database Engine:" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="{Binding PreferredDatabase, StringFormat='{}{0} (Port: 3306)'}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Provision Steps Checklist -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Configuration Steps to Apply:" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding ProvisionSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Prominent In-Content Action Button -->
                        <Button Content="▶ Apply Setup Now" Style="{StaticResource PrimaryButton}" Command="{Binding ApplySetupCommand}" 
                                Height="36" Padding="24,0" FontSize="12.5" HorizontalAlignment="Right" Margin="0,0,0,4" />
                    </StackPanel>

                    <!-- STATE 2: RUNNING PROVISIONING -->
                    <StackPanel Visibility="{Binding IsStep5Running, Converter={StaticResource BoolToVis}}">
                        <!-- Progress Bar & Status -->
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="Applying Configuration..." FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProvisionProgress, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ProgressBar Value="{Binding ProvisionProgress}" Height="6" Maximum="100" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding ProvisionStatus}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Live Steps Checklist -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10">
                            <ItemsControl ItemsSource="{Binding ProvisionSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>

                    <!-- STATE 3: SETUP FAILED (With Diagnostic Details, Retry, and Back options) -->
                    <StackPanel Visibility="{Binding IsStep5Failed, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource ErrorBgBrush}" BorderBrush="{StaticResource ErrorBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Setup Could Not Be Completed" FontSize="13" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <TextBlock Text="You can review the error above, adjust previous settings, or retry applying the setup." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Live Steps Checklist showing the failed step -->
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="14,10" Margin="0,0,0,14">
                            <ItemsControl ItemsSource="{Binding ProvisionSteps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <!-- Error Recovery Actions -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="← Back to Settings" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousStepCommand}" Height="34" Padding="14,0" Margin="0,0,8,0" />
                            <Button Content="↻ Retry Apply Setup" Style="{StaticResource PrimaryButton}" Command="{Binding RetryApplySetupCommand}" Height="34" Padding="18,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- STATE 4: SETUP COMPLETED SUCCESSFULLY -->
                    <StackPanel Visibility="{Binding IsStep5Success, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,16,0,0">
                        <Border Width="56" Height="56" Background="{StaticResource SuccessBgBrush}" BorderBrush="{StaticResource SuccessBorderBrush}" 
                                BorderThickness="1" CornerRadius="28" HorizontalAlignment="Center" Margin="0,0,0,14">
                            <TextBlock Text="✓" FontSize="26" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Your Loka Environment is Ready!" Style="{StaticResource HeadingLarge}" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock Text="Environment configuration, runtimes, and local paths have been verified and initialized." 
                                   Style="{StaticResource SubHeading}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,0,0,20" />

                        <Button Content="Open Loka Dashboard →" Style="{StaticResource PrimaryButton}" Command="{Binding FinishSetupCommand}" 
                                Height="38" Padding="24,0" FontSize="13" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- STATE 5: FALLBACK GUARANTEE (Guarantees content is NEVER blank under any circumstances) -->
                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,10,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAnyStep5StateActive}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="Apply Setup Ready" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock Text="Click below to apply your development environment configuration." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <Button Content="Apply Setup" Style="{StaticResource PrimaryButton}" Command="{Binding ApplySetupCommand}" Height="34" Padding="20,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer Navigation Buttons -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <!-- Hide footer buttons on welcome screen and on completion -->
                        <DataTrigger Binding="{Binding IsWelcomeStep}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsStep5Success}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid VerticalAlignment="Center">
                <Button Content="← Back" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousStepCommand}" HorizontalAlignment="Left" Width="80" Height="28"
                        IsEnabled="{Binding IsNotProvisioning}" />

                <!-- Action Button in Step 5 (Apply Setup) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            Visibility="{Binding IsStep5, Converter={StaticResource BoolToVis}}">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelSetupCommand}" Height="28" Padding="12,0" Margin="0,0,8,0"
                            IsEnabled="{Binding IsNotProvisioning}" />
                    <Button Content="Apply Setup" Style="{StaticResource PrimaryButton}" Command="{Binding ApplySetupCommand}" Height="28" Padding="16,0"
                            IsEnabled="{Binding IsNotProvisioning}"
                            Visibility="{Binding IsProvisionNotComplete, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- Next button for steps 1 to 4 -->
                <Button Content="Continue →" Command="{Binding NextStepCommand}" HorizontalAlignment="Right" Width="96" Height="28">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
