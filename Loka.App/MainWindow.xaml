<Window x:Class="Loka.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Loka.App.Views"
        xmlns:vm="clr-namespace:Loka.App.ViewModels"
        mc:Ignorable="d"
        Title="Loka - Developer Environment"
        Icon="pack://application:,,,/Loka;component/Resources/loka.ico"
        Height="620" Width="1000"
        MinHeight="500" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI, Arial, sans-serif"
        FontSize="12"
        Foreground="{StaticResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation (Ui.md Section 2.A & 3: 160-175px width, FAFAFA background, monochrome) -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Brand Header (Ui.md Section 20 & 27: 36-42px height, transparent logo) -->
                <Border Grid.Row="0" Height="40" Padding="14,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" Margin="0,0,8,0">
                            <Image Source="pack://application:,,,/Loka;component/Resources/logo_24.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <TextBlock Text="LOKA" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Navigation Links: 7 menus — Overview, Projects, PHP & Tools, Database, Terminal, Diagnostics, Settings -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
                    <StackPanel>
                        <!-- Overview -->
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding IsDashboardActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Dashboard">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconOverview}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Overview" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Projects -->
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding IsProjectsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Projects">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconProjects}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Projects" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- PHP & Tools -->
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding IsPHPToolsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="PHPTools">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTools}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="PHP &amp; Tools" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Database (includes phpMyAdmin access) -->
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding IsDatabasesActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Database">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPhpMyAdmin}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Database" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Terminal (Agent.md Section 4.F) -->
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding IsTerminalActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Terminal">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconTerminal}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Terminal" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <!-- Diagnostics (Agent.md Section 4.G) -->
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding IsDiagnosticsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Diagnostics">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconDiagnostics}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Diagnostics" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="4,6" />

                        <!-- Settings (Agent.md Section 4.H) -->
                        <RadioButton Style="{StaticResource NavButton}"
                                     IsChecked="{Binding IsSettingsActive, Mode=TwoWay}"
                                     Command="{Binding NavigateCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar Footer Status (Ui.md Section 16 & 18: Subtle status dot + text) -->
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                        Padding="12,8" Background="{StaticResource SurfaceSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="8" Margin="0,0,6,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="○" />
                                    <Setter Property="Foreground" Value="{StaticResource NeutralBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasRunningServices}" Value="True">
                                            <Setter Property="Text" Value="●" />
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding RunningServicesStatus}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area with Unified Top Bar (Ui.md Section 4) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Unified Top Bar -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Page Title & Environment Path Indicator -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                ToolTip="{Binding EnvironmentPath}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📁 " FontSize="9" VerticalAlignment="Center" Margin="0,0,2,0" />
                                <TextBlock Text="{Binding EnvironmentPath}" MaxWidth="160" TextTrimming="CharacterEllipsis" FontSize="11" FontFamily="Cascadia Code, Consolas" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Quick Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="📁 Environment" Style="{StaticResource SecondaryButton}" Height="24" Padding="6,0" Margin="0,0,4,0" FontSize="11"
                                Command="{Binding OpenEnvironmentFolderCommand}" ToolTip="Open environment folder in File Explorer" />
                        <Button Content="{Binding RunningServicesStatus}" Style="{StaticResource SecondaryButton}" Height="24" Padding="6,0" FontSize="11"
                                Command="{Binding ToggleAllServicesCommand}" ToolTip="Toggle all development services" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Host -->
            <Border Grid.Row="1" Background="{StaticResource BackgroundBrush}">
                <ContentControl Content="{Binding CurrentViewModel}">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                            <views:DashboardView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:ProjectsViewModel}">
                            <views:ProjectsView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DatabaseViewModel}">
                            <views:DatabaseView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:RuntimesViewModel}">
                            <views:RuntimesView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                            <views:DiagnosticsView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:TerminalViewModel}">
                            <views:TerminalView />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                            <views:SettingsView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </Border>
        </Grid>

    </Grid>
</Window>
